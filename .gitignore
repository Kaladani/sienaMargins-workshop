# Quarto working state
/.quarto/
**/*.quarto_ipynb

# Rendered output (see output-dir in _quarto.yml).  Published to the gh-pages
# branch by CI rather than tracked here.
/_book/

# NOT ignored on purpose: /_freeze/ ships, so the book renders without
# refitting any models.  See the note in _quarto.yml.

# RSiena writes an estimation report into the working directory whenever
# siena() runs, so rendering chapters 4 and 5 leaves these behind.
*_out.txt
.txt

# The AK data are not redistributed here.  They live in data/ locally -- either
# downloaded on first use (scripts/download_data.R) or already to hand -- but
# they are deliberately kept out of the repository.  See data/README.md.
/data/*.RData
/data/*.pdf

# macOS
.DS_Store
**/.DS_Store
.Rproj.user
